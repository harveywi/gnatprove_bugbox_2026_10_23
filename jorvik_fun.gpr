with "config/jorvik_fun_config.gpr";
project Jorvik_Fun is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Jorvik_Fun_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("jorvik_fun.adb");

   package Compiler is
      for Default_Switches ("Ada") use Jorvik_Fun_Config.Ada_Compiler_Switches & (
         "-gnat2022",
         "-gnatwa",
         "-gnatVa",
         "-gnata",
         "-gnatyM120",
         "-g"
      );
      for Local_Configuration_Pragmas use "gnat.adc";
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Jorvik_Fun;
